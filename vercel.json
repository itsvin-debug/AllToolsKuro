{
  "framework": "vite",
  "installCommand": "npm install && npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"AllToolsKuro.apk\""
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/stalk/(.*)",
      "destination": "/api/media?__route=stalk&platform=$1"
    },
    {
      "source": "/api/tools/tiktok-stalk",
      "destination": "/api/media?__route=stalk&platform=tiktok"
    },
    {
      "source": "/api/tiktok-stalk",
      "destination": "/api/media?__route=stalk&platform=tiktok"
    },
    {
      "source": "/api/download",
      "destination": "/api/media?__route=download"
    },
    {
      "source": "/api/anime/search",
      "destination": "/api/media?type=anime"
    },
    {
      "source": "/api/manhwa/search",
      "destination": "/api/media?type=manhwa"
    },
    {
      "source": "/api/proxy-download",
      "destination": "/api/proxy-download"
    },
    {
      "source": "/api/proxy-stream",
      "destination": "/api/proxy-download?stream=true"
    },
    {
      "source": "/api/proxy-doc-image",
      "destination": "/api/proxy-download?stream=true"
    },
    {
      "source": "/api/tools/image-proxy",
      "destination": "/api/proxy-download?stream=true"
    },
    {
      "source": "/api/image-proxy",
      "destination": "/api/proxy-download?stream=true"
    },
    {
      "source": "/api/tools/tiktok-avatar",
      "destination": "/api/proxy-download?stream=true"
    },
    {
      "source": "/api/tiktok-avatar",
      "destination": "/api/proxy-download?stream=true"
    },
    {
      "source": "/api/stalk/image-proxy",
      "destination": "/api/proxy-download?stream=true"
    },
    {
      "source": "/api/jj/find",
      "destination": "/api/media?__route=jj-finder"
    },
    {
      "source": "/api/jj-finder",
      "destination": "/api/media?__route=jj-finder"
    },
    {
      "source": "/api/resolve",
      "destination": "/api/tools?__route=resolve"
    },
    {
      "source": "/api/compress-pdf",
      "destination": "/api/tools?__route=compress-pdf"
    },
    {
      "source": "/api/link-to-doc",
      "destination": "/api/tools?__route=link-to-doc"
    },
    {
      "source": "/api/ip-check",
      "destination": "/api/tools?__route=ip-check"
    },
    {
      "source": "/api/locked-tools",
      "destination": "/api/tools?__route=locked-tools"
    },
    {
      "source": "/api/verify-admin",
      "destination": "/api/tools?__route=locked-tools"
    },
    {
      "source": "/api/ping",
      "destination": "/api/tools?__route=locked-tools&action=ping"
    },
    {
      "source": "/api/version",
      "destination": "/api/tools?__route=version"
    },
    {
      "source": "/api/app/version",
      "destination": "/api/tools?__route=version"
    },
    {
      "source": "/api/system-battery",
      "destination": "/api/tools?__route=version&action=battery"
    },
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|version\\.json|.*\\.apk|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
